<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude mutable object exposure for domain models, DTOs, and Swing listeners/components -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Swing components implement Serializable, but Swing GUI components are not intended for Java serialization -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_BAD_FIELD_STORE,SE_TRANSIENT_FIELD_NOT_RESTORED,SE_NO_SERIALVERSIONID,SE_COMPARATOR_SHOULD_BE_SERIALIZABLE" />
    </Match>

    <!-- Defensive exceptions thrown in constructors for domain validation (modern Java finalizer attacks are obsolete) -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>

    <!-- Singleton getInstance() methods returning shared mutable instance -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP" />
    </Match>

    <!-- TrackTableModel static column key array -->
    <Match>
        <Class name="com.musiclibrary.ui.table.TrackTableModel" />
        <Field name="COLUMN_KEYS" />
        <Bug pattern="MS_MUTABLE_ARRAY" />
    </Match>

    <!-- Singletons providing public/package-private constructors for DI and unit testing -->
    <Match>
        <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR" />
    </Match>

    <!-- Catching general Exception for defensive UI event handling, background workers, and I/O fallback -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION" />
    </Match>
</FindBugsFilter>
